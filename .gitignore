node_modules
dist
*.tsbuildinfo

# Secrets — the live SnapServe key lives here, never commit it
.env
.env.*
snapserve-setup/.env

# API response dumps from working against the live account.
# These contain real call transcripts, customer phone numbers, wallet balance and
# account ids — working artifacts, not source. The payloads we author are kept;
# the responses the account sends back are not.
snapserve-setup/*-result*.json
snapserve-setup/*-fix.json
snapserve-setup/*-refix.json
snapserve-setup/agent-current*.json
snapserve-setup/arun-current.json
snapserve-setup/arun-after-tool.json
snapserve-setup/call-*.json
snapserve-setup/calls-list.json
snapserve-setup/wallet.json
